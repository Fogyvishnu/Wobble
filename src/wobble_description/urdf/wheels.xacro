<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wobble_wheel" params="prefix reflect">

    <xacro:property name="wheel_radius" value="0.035"/>
    <xacro:property name="wheel_width" value="0.022"/>
    <xacro:property name="wheel_mass" value="0.065"/>

    <link name="${prefix}_wheel">
      <!-- Outer Rubber Tire -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber_black"/>
      </visual>

      <!-- Inner Rim Accent -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.6}" length="${wheel_width + 0.001}"/>
        </geometry>
        <material name="accent_blue"/>
      </visual>

      <!-- Collision Cylinder -->
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- Inertia for Solid Cylinder -->
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(wheel_mass / 12.0) * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(wheel_mass / 12.0) * (3.0*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>

    <!-- Continuous Drive Wheel Joint (DC Encoder Motor) -->
    <joint name="joint_${prefix}_wheel" type="continuous">
      <parent link="${prefix}_wheel_hub"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect * (wheel_width/2.0 + 0.005)} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.005" friction="0.002"/>
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>10.0</maxVel>
      <material>Gazebo/DarkGrey</material>
    </gazebo>

  </xacro:macro>

</robot>
