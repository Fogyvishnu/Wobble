<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wobble_control</name>
  <version>0.1.0</version>
  <description>Cascaded PID balance and 4-bar posture controllers for Wobble robot</description>
  <maintainer email="vish@todo.todo">vish</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>effort_controllers</depend>
  <depend>position_controllers</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
